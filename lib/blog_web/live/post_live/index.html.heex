<div class="max-w-3xl mx-auto px-4 py-10" data-theme="light" style="color-scheme: light">
  <header class="mb-10">
    <h1 class="font-serif text-4xl text-slate-900 tracking-tight">Posts</h1>
    <p class="mt-2 text-slate-500">
      Showing {length(@posts)} of {@total_entries} posts
    </p>
  </header>

  <form phx-change="filter" phx-submit="filter" class="mb-8 space-y-4">
    <div>
      <label for="search" class="block text-sm text-slate-600 mb-1">Search</label>
      <input
        type="text"
        id="search"
        name="search"
        value={@search}
        placeholder="Search titles and content…"
        phx-debounce="300"
        class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-teal-600 focus:border-teal-600"
      />
    </div>

    <div class="flex flex-wrap gap-4">
      <div class="flex-1 min-w-[10rem]">
        <label for="tag" class="block text-sm text-slate-600 mb-1">Tag</label>
        <select
          id="tag"
          name="tag"
          class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 focus:outline-none focus:ring-2 focus:ring-teal-600 focus:border-teal-600"
        >
          <option value="">All tags</option>
          <option :for={t <- @all_tags} value={t} selected={t == @tag}>{t}</option>
        </select>
      </div>

      <div class="flex-1 min-w-[10rem]">
        <label for="sort_by" class="block text-sm text-slate-600 mb-1">Sort by</label>
        <select
          id="sort_by"
          name="sort_by"
          class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 focus:outline-none focus:ring-2 focus:ring-teal-600 focus:border-teal-600"
        >
          <option value="newest" selected={@sort_by == "newest"}>Newest first</option>
          <option value="oldest" selected={@sort_by == "oldest"}>Oldest first</option>
          <option value="title" selected={@sort_by == "title"}>Title, A to Z</option>
        </select>
      </div>
    </div>
  </form>

  <ul :if={@posts != []} class="divide-y divide-slate-200 border-t border-slate-200">
    <li :for={post <- @posts} class="py-5">
      <.link navigate={~p"/posts/#{post}"} class="block group">
        <h2 class="font-serif text-xl text-slate-900 group-hover:text-teal-700">
          {post.title}
        </h2>
      </.link>

      <p class="mt-1 text-sm text-slate-500">
        <span class="capitalize">{post.metadata["category"]}</span>
        <span class="mx-2">·</span>
        <span>{post.metadata["author"]}</span>
        <span class="mx-2">·</span>
        <time>{Calendar.strftime(post.inserted_at, "%b %-d, %Y")}</time>
      </p>

      <div :if={post.tags != []} class="mt-3 flex flex-wrap gap-1.5">
        <button
          :for={t <- post.tags}
          type="button"
          phx-click="filter"
          phx-value-search={@search}
          phx-value-tag={t}
          phx-value-sort_by={@sort_by}
          class="rounded-full border border-slate-200 px-2.5 py-0.5 text-xs text-slate-600 hover:border-teal-600 hover:text-teal-700"
        >
          {t}
        </button>
      </div>
    </li>
  </ul>

  <div :if={@posts == []} class="border-t border-slate-200 py-16 text-center">
    <p class="text-slate-600">No posts match those filters.</p>
    <.link patch={~p"/posts"} class="mt-2 inline-block text-sm text-teal-700 hover:underline">
      Clear filters
    </.link>
  </div>

  <nav :if={@posts != []} class="flex items-center justify-between mt-10 text-sm">
    <button
      phx-click="paginate"
      phx-value-page={@page - 1}
      disabled={@page <= 1}
      class="text-slate-600 hover:text-teal-700 disabled:opacity-30 disabled:hover:text-slate-600"
    >
      ← Previous
    </button>

    <span class="text-slate-500">
      Page {@page} of {@total_pages}
    </span>

    <button
      phx-click="paginate"
      phx-value-page={@page + 1}
      disabled={@page >= @total_pages}
      class="text-slate-600 hover:text-teal-700 disabled:opacity-30 disabled:hover:text-slate-600"
    >
      Next →
    </button>
  </nav>
</div>
